---
import Footer from "../components/Footer.astro";

const socialLinks = [
  {
    label: "LINKEDIN",
    href: "https://www.linkedin.com/in/jaehoon-ju-43837b112/",
  },  
  {
    label: "INSTAGRAM",
    href: "https://www.instagram.com/ja3hoooon/",
  },
  {
    label: "THREADS",
    href: "https://www.threads.net/@ja3hoooon",
  },
];

const experiences = [
  {
    number: "01",
    company: "Loro Piana Korea",
    role: "PR & Communication Director · LVMH Group",
  },
  {
    number: "02",
    company: "Berluti Korea",
    role: "Lead of Communications · Senior Manager · LVMH Group",
  },
  {
    number: "03",
    company: "PVH Korea",
    role: "Head of Marketing · Calvin Klein",
  },
  {
    number: "04",
    company: "Amorepacific",
    role: "Global Marketing Manager · Laneige & IOPE",
  },
];

const expertise = [
  {
    number: "I",
    title: "Luxury & Global Brand Strategy",
    text:
      "글로벌 메종의 브랜드 포지셔닝부터 마케팅·PR 전략까지 총괄하며, 고유한 헤리티지와 비즈니스 목표를 하나의 방향으로 정렬합니다.",
  },
  {
    number: "II",
    title: "Integrated Communications",
    text:
      "글로벌 HQ와 로컬, PR, VIC, 앰버서더 및 오프라인 경험을 단단하게 연결해 하나의 일관된 브랜드 아우라를 완성합니다.",
  },
  {
    number: "III",
    title: "AI & Cultural Intelligence",
    text:
      "AI와 디지털 환경 속에서도 기술이 결코 흉내 낼 수 없는 문화적 감도와 인간의 디렉팅을 브랜드의 가장 희소한 가치로 정의합니다.",
  },
];
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="About Archives Intimes & Jaehoon Ju — Luxury, heritage, technology and perspectives."
    />

    <title>About | Archives Intimes</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>

  <body>

    <header>
      <div class="page header-inner">

        <a href="/" class="brand">
          ARCHIVES INTIMES
        </a>

        <nav>
          <a href="/">HOME</a>
          <a href="/about">ABOUT</a>
          <a href="/journal">JOURNAL</a>
        </nav>

      </div>
    </header>


    <main>

      <!-- ABOUT HERO -->

      <section class="about-hero">

        <div class="page">

          <div class="about-kicker">
            ABOUT / PROFILE
          </div>


          <div class="about-grid">

            <!-- PORTRAIT -->

            <figure class="portrait">

              <img
                src="/images/about-portrait.jpg"
                alt="Jaehoon Ju"
              />

              <figcaption class="portrait-caption">
                <span class="caption-name-en">Jaehoon Ju</span>
                <span class="caption-name-kr">주재훈 · 아카이브 앙팀(Archives Intimes)</span>
              </figcaption>

            </figure>


            <!-- PROFILE -->

            <div class="about-copy">

              <div class="profile-top">

                <h1 class="about-title">
                  Luxury, Culture<br />
                  &amp; Communication.
                </h1>


                <p class="about-intro">
                  럭셔리와 패션, 뷰티, 라이프스타일 영역에서 18년 넘게 브랜드의 성장을 이끌어왔습니다.
                  LVMH 그룹을 비롯한 글로벌 하우스에서 포지셔닝 전략부터 PR, VIC 마케팅에 이르는 통합 커뮤니케이션을 총괄했습니다.
                  오랜 시간 축적된 메종 고유의 헤리티지를 정교하게 해석하는 동시에, 빠르게 진화하는 기술과 문화적 통찰을 결합해 브랜드의 대체 불가능한 내러티브와 비즈니스 임팩트를 완성해 나갑니다.
                </p>
                
              </div>


              <!-- CURRENT / CONNECT -->

              <div class="profile-bottom">

                <div class="current">

                  <div class="current-label">
                    CURRENT
                  </div>

                  <div class="current-role">
                    PR &amp; Communication Director
                  </div>

                  <div class="current-company">
                    Loro Piana Korea · LVMH Group
                  </div>

                </div>


                <div class="profile-connect">

                  <span class="connect-label">CONNECT</span>

                  <div class="profile-social">
                    {
                      socialLinks.map((social) => (
                        <a
                          href={social.href}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {social.label}
                        </a>
                      ))
                    }
                  </div>

                </div>

              </div>

            </div>

          </div>

        </div>

      </section>


      <!-- SELECTED EXPERIENCE -->

      <section class="experience">

        <div class="page">

          <div class="experience-head">

            <div class="section-label">
              SELECTED EXPERIENCE
            </div>

            <p class="experience-statement">
              <span>
                A career shaped across luxury and global brands,&nbsp; 
              </span>

              <span>
                including LVMH, PVH, and Amorepacific.
              </span>
            </p>

          </div>


          <div class="experience-list">

            {
              experiences.map((item) => (

                <div class="experience-row">

                  <span class="experience-number">
                    {item.number}
                  </span>

                  <span class="experience-company">
                    {item.company}
                  </span>

                  <span class="experience-role">
                    {item.role}
                  </span>

                </div>

              ))
            }

          </div>

        </div>

      </section>


      <!-- CAREER / 18+ -->

      <section class="career">

        <div class="page career-grid">

          <div class="career-number">

            <div class="years">
              18+
            </div>

            <div class="years-copy">
              YEARS ACROSS LUXURY, FASHION,<br />
              BEAUTY &amp; LIFESTYLE
            </div>

          </div>


          <figure class="career-visual">

            <img
              src="/images/about-career-visual.png"
              alt="Archives Intimes career editorial visual"
            />

            <figcaption>
              AI-generated visual
            </figcaption>

          </figure>

        </div>

      </section>


      <!-- CORE EXPERTISE -->

      <section class="expertise">

        <div class="page">

          <div class="expertise-head">

            <div class="section-label">
              CORE EXPERTISE &amp; VISION
            </div>

            <h2 class="expertise-title">
              Strategy, communication and cultural intelligence
              in an age of acceleration.
            </h2>

          </div>


          <div class="expertise-list">

            {
              expertise.map((item) => (

                <div class="expertise-item">

                  <div class="expertise-number">
                    {item.number}
                  </div>

                  <div class="expertise-content">

                    <h3>
                      {item.title}
                    </h3>

                    <p>
                      {item.text}
                    </p>

                  </div>

                </div>

              ))
            }

          </div>

        </div>

      </section>

    </main>


    <Footer />


    <style>

      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        background: #f4f1ea;
        color: #11110f;
        font-family: Arial, Helvetica, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      :global(a) {
        color: inherit;
        text-decoration: none;
      }

      :root {
        --bg: #f4f1ea;
        --text: #11110f;
        --muted: #6f6a63;
        --body: #514d47;
        --line: rgba(17, 17, 15, 0.18);
      }


      /* PAGE */

      .page {
        width: min(1220px, calc(100% - 72px));
        margin: 0 auto;
      }


      /* HEADER */

      header {
        border-bottom: 1px solid var(--line);
      }

      .header-inner {
        min-height: 110px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .brand {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 18px;
        letter-spacing: 0.025em;
      }

      nav {
        display: flex;
        gap: 34px;
        font-size: 11px;
        letter-spacing: 0.16em;
      }


      /* ABOUT HERO */

      .about-hero {
        padding: 76px 0 72px;
      }

      .about-kicker {
        margin-bottom: 36px;
        color: var(--muted);
        font-size: 11px;
        letter-spacing: 0.2em;
      }

      .about-grid {
        display: grid;
        grid-template-columns:
          minmax(360px, 0.84fr)
          minmax(0, 1.16fr);

        gap: 86px;
        align-items: start;
      }


      /* PORTRAIT */

      .portrait {
        margin: 0;
      }

      .portrait img {
        display: block;
        width: 100%;
        height: 570px;
        object-fit: cover;
        object-position: center;
      }

      .portrait-caption {
        margin-top: 12px;
        color: var(--muted);
        line-height: 1.45;
      }
      
      .caption-name-en {
        display: block;
        
        font-family:
         Georgia,
         "Times New Roman",
         serif;
         
        font-size: 11px;
        font-style: italic;
      }
      
      .caption-name-kr {
        display: block;
        margin-top: 2px;
        
        font-size: 10px;
        letter-spacing: 0.04em;
      }


      /* PROFILE */

      .about-copy {
        min-height: 570px;

        display: flex;
        flex-direction: column;
      }

      .profile-top {
        width: 100%;
      }

      .about-title {
        max-width: 720px;
        margin: -8px 0 0;

        font-family:
          Georgia,
          "Times New Roman",
          serif;

        font-size:
          clamp(
            55px,
            5.8vw,
            82px
          );

        font-weight: 400;
        line-height: 0.98;
        letter-spacing: -0.045em;
      }

      .about-intro {
        max-width: 620px;
        margin: 42px 0 0;

        color: var(--body);

        font-size: 15px;
        line-height: 2;

        word-break: keep-all;
      }


      /* PROFILE BOTTOM */

      .profile-bottom {
        margin-top: auto;
        padding-top: 24px;
        border-top: 1px solid var(--line);
      }


      /* CURRENT */

      .current {
        margin: 0;
        padding: 0;
      }

      .current-label {
        margin-bottom: 17px;
        color: var(--muted);
        font-size: 10px;
        letter-spacing: 0.17em;
      }

      .current-role {
        font-family:
          Georgia,
          "Times New Roman",
          serif;

        font-size: 20px;
        line-height: 1.35;
      }

      .current-company {
        margin-top: 7px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.5;
      }


      /* CONNECT / SOCIAL */

      .profile-connect {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-top: 24px;
        padding-top: 18px;
        border-top: 1px solid rgba(17, 17, 15, 0.08);
      }

      .connect-label {
        color: #9a948b;
        font-size: 9.5px;
        letter-spacing: 0.16em;
        font-weight: 500;
      }

      .profile-social {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 18px;
      }

      .profile-social a {
        padding-bottom: 2px;
        color: var(--muted);
        border-bottom: 1px solid transparent;
        font-size: 10px;
        letter-spacing: 0.14em;
        transition: opacity 0.2s ease, border-color 0.2s ease, color 0.2s ease;
      }

      .profile-social a:hover {
        color: var(--text);
        opacity: 0.6;
        border-color: var(--muted);
      }


      /* SECTION LABEL */

      .section-label {
        color: var(--muted);
        font-size: 11px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
      }


      /* EXPERIENCE */

      .experience {
        padding: 66px 0 86px;
        border-top: 1px solid var(--line);
      }

      .experience-head {
        margin-bottom: 52px;
      }

      .experience-head .section-label {
        margin-bottom: 24px;
      }

      .experience-statement {
        margin: 0;

        font-family:
          Georgia,
          "Times New Roman",
          serif;

        font-size: 28px;
        font-weight: 400;
        line-height: 1.18;
        letter-spacing: -0.02em;
      }

      .experience-statement span {
        display: block;
      }

      .experience-list {
        border-top: 1px solid var(--line);
      }

      .experience-row {
        display: grid;

        grid-template-columns:
          80px 1fr 1.15fr;

        gap: 34px;

        align-items: center;

        padding: 23px 0;

        border-bottom:
          1px solid var(--line);
      }

      .experience-number {
        color: var(--muted);
        font-size: 10px;
        letter-spacing: 0.15em;
      }

      .experience-company {
        font-family:
          Georgia,
          "Times New Roman",
          serif;

        font-size: 21px;
        line-height: 1.3;
      }

      .experience-role {
        color: var(--body);
        font-size: 12px;
        line-height: 1.65;
      }


      /* CAREER */

      .career {
        padding: 78px 0 92px;
        border-top: 1px solid var(--line);
      }

      .career-grid {
        display: grid;
        grid-template-columns: 0.72fr 1.28fr;
        gap: 84px;
        align-items: end;
      }

      .career-number {
        padding-bottom: 18px;
      }

      .years {
        font-family:
          Georgia,
          "Times New Roman",
          serif;

        font-size:
          clamp(
            112px,
            13vw,
            182px
          );

        font-weight: 400;
        line-height: 0.82;
        letter-spacing: -0.065em;
      }

      .years-copy {
        margin-top: 34px;
        color: var(--muted);
        font-size: 10px;
        line-height: 1.8;
        letter-spacing: 0.16em;
      }

      .career-visual {
        margin: 0;
      }

      .career-visual img {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
      }

      .career-visual figcaption {
        margin-top: 10px;
        color: var(--muted);

        font-family:
          Georgia,
          "Times New Roman",
          serif;

        font-size: 10px;
        font-style: italic;
      }


      /* EXPERTISE */

      .expertise {
        padding: 72px 0 96px;
        border-top: 1px solid var(--line);
      }

      .expertise-head {
        display: grid;
        grid-template-columns: 0.34fr 0.66fr;
        gap: 74px;
        align-items: start;
        margin-bottom: 66px;
      }

      .expertise-title {
        max-width: 750px;
        margin: 0;

        font-family:
          Georgia,
          "Times New Roman",
          serif;

        font-size:
          clamp(
            36px,
            4vw,
            56px
          );

        font-weight: 400;
        line-height: 1.08;
        letter-spacing: -0.035em;
      }

      .expertise-list {
        border-top: 1px solid var(--line);
      }

      .expertise-item {
        display: grid;
        grid-template-columns: 90px 1fr;
        gap: 34px;
        padding: 36px 0;
        border-bottom: 1px solid var(--line);
      }

      .expertise-number {
        color: var(--muted);

        font-family:
          Georgia,
          "Times New Roman",
          serif;

        font-size: 15px;
        font-style: italic;
      }

      .expertise-content {
        display: grid;
        grid-template-columns: 0.72fr 1.28fr;
        gap: 66px;
      }

      .expertise-content h3 {
        margin: 0;

        font-family:
          Georgia,
          "Times New Roman",
          serif;

        font-size: 23px;
        font-weight: 400;
        line-height: 1.25;
        letter-spacing: -0.02em;
      }

      .expertise-content p {
        max-width: 570px;
        margin: 0;
        color: var(--body);
        font-size: 14px;
        line-height: 1.95;
        word-break: keep-all;
      }


      /* TABLET */

      @media (max-width: 900px) {

        .page {
          width: min(100% - 40px, 1220px);
        }

        .about-grid {
          grid-template-columns:
            0.85fr 1.15fr;

          gap: 48px;
        }

        .portrait img {
          height: 530px;
        }

        .about-copy {
          min-height: 530px;
        }

        .about-title {
          font-size: 54px;
        }

        .about-intro {
          margin-top: 30px;
          font-size: 14px;
          line-height: 1.85;
        }

        .profile-bottom {
          padding-top: 20px;
        }

        .career-grid {
          gap: 48px;
        }

        .expertise-head {
          grid-template-columns: 1fr;
          gap: 24px;
        }

        .expertise-content {
          grid-template-columns:
            0.8fr 1.2fr;

          gap: 40px;
        }

      }


      /* MOBILE */

      @media (max-width: 600px) {

        .page {
          width: calc(100% - 28px);
        }

        header {
          padding: 26px 0 22px;
        }

        .header-inner {
          display: block;
          min-height: auto;
        }

        nav {
          margin-top: 20px;
          justify-content: space-between;
          gap: 18px;
        }

        .about-hero {
          padding: 52px 0 58px;
        }

        .about-kicker {
          margin-bottom: 28px;
        }

        .about-grid {
          grid-template-columns: 1fr;
          gap: 38px;
        }

        .portrait img {
          height: auto;
          aspect-ratio: 4 / 5;
        }

        .about-copy {
          min-height: auto;
        }

        .about-title {
          margin-top: 0;
          font-size: 38px;
          line-height: 1.05;
        }

        .about-intro {
          margin-top: 30px;
          font-size: 15px;
          line-height: 1.9;
        }

        .profile-bottom {
          margin-top: 34px;
          padding-top: 22px;
        }

        .profile-connect {
          margin-top: 20px;
          padding-top: 16px;
        }

        .profile-social {
          gap: 12px 18px;
        }

        .experience {
          padding: 54px 0 64px;
        }

        .experience-head {
          margin-bottom: 38px;
        }

        .experience-statement {
          font-size: 25px;
        }

        .experience-statement span {
          display: inline;
        }

        .experience-row {
          grid-template-columns:
            42px 1fr;

          gap: 14px 18px;
          padding: 20px 0;
        }

        .experience-role {
          grid-column: 2;
          margin-top: -4px;
        }

        .experience-company {
          font-size: 19px;
        }

        .career {
          padding: 58px 0 68px;
        }

        .career-grid {
          grid-template-columns: 1fr;
          gap: 48px;
        }

        .years {
          font-size: 116px;
        }

        .career-visual img {
          aspect-ratio: 4 / 3;
        }

        .expertise {
          padding: 58px 0 70px;
        }

        .expertise-head {
          margin-bottom: 46px;
        }

        .expertise-title {
          font-size: 35px;
        }

        .expertise-item {
          grid-template-columns:
            38px 1fr;

          gap: 18px;
          padding: 30px 0;
        }

        .expertise-content {
          grid-template-columns: 1fr;
          gap: 18px;
        }

        .expertise-content h3 {
          font-size: 21px;
        }

        .expertise-content p {
          font-size: 14px;
          line-height: 1.85;
        }

      }

    </style>

  </body>
</html>
---
import Footer from "../components/Footer.astro";
import { journalPosts } from "../data/journal.js";

const latestPost = journalPosts[0];
const archive = journalPosts.slice(1);
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="Archives Intimes Journal — Luxury, heritage, technology and perspectives."
    />

    <title>Journal | Archives Intimes</title>

    <!-- Korean Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;600&family=Noto+Serif+KR:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>

    <header>
      <div class="page header-inner">

        <a href="/" class="brand">
          ARCHIVES INTIMES
        </a>

        <nav>
          <a href="/">HOME</a>
          <a href="/about">ABOUT</a>
          <a href="/journal">JOURNAL</a>
        </nav>

      </div>
    </header>


    <main>

      <!-- JOURNAL HERO -->

      <section class="journal-hero">

        <div class="page">

          <div class="journal-kicker">
            JOURNAL / ARCHIVE
          </div>

          <h1 class="journal-title">
            Journal
          </h1>

        </div>

      </section>


      <!-- LATEST JOURNAL -->

      <section class="featured">

        <div class="page">

          <div class="featured-meta">

            <span>
              LATEST
            </span>

            <span>
              {latestPost.volume}
            </span>

            <span>
              {latestPost.date}
            </span>

          </div>


          <div class="featured-grid">

            <div class="featured-copy">

              <h2 class="featured-title">
                {latestPost.title}
              </h2>

              <p class="featured-subtitle">
                {latestPost.subtitle}
              </p>

              <a
                href={latestPost.href}
                class="featured-link"
              >
                READ STORY →
              </a>

            </div>


            {
              latestPost.image && (

                <a
                  href={latestPost.href}
                  class="featured-visual"
                  aria-label={`Read ${latestPost.volume}`}
                >

                  <img
                    src={latestPost.image}
                    alt={`${latestPost.volume} Archives Intimes editorial visual`}
                  />

                  <span class="image-caption">
                    AI-generated visual
                  </span>

                </a>

              )
            }

          </div>

        </div>

      </section>


      <!-- ARCHIVE -->

      <section class="archive">

        <div class="page">

          <div class="archive-head">
            ARCHIVE
          </div>


          <div class="archive-list">

            {
              archive.map((article) => (

                <a
                  class="archive-row"
                  href={article.href}
                >

                  <span class="archive-volume">
                    {article.volume}
                  </span>


                  <span class="archive-title">
                    {article.title}
                  </span>


                  <span class="archive-date">
                    {article.date}
                  </span>

                </a>

              ))
            }

          </div>

        </div>

      </section>

    </main>


    <Footer />


    <style>

      :global(*) {
        box-sizing: border-box;
      }


      :global(html) {
        scroll-behavior: smooth;
      }


      :global(body) {
        margin: 0;

        background: #f4f1ea;

        color: #11110f;

        font-family:
          Arial,
          "Noto Sans KR",
          Helvetica,
          sans-serif;

        -webkit-font-smoothing:
          antialiased;
      }


      :global(a) {
        color: inherit;
        text-decoration: none;
      }


      :root {
        --bg: #f4f1ea;
        --text: #11110f;
        --muted: #6f6a63;
        --body: #514d47;
        --line: rgba(17, 17, 15, 0.18);
      }


      /* PAGE */

      .page {
        width:
          min(
            1220px,
            calc(100% - 72px)
          );

        margin:
          0 auto;
      }


      /* HEADER */

      header {
        border-bottom:
          1px solid var(--line);
      }


      .header-inner {
        min-height:
          110px;

        display:
          flex;

        justify-content:
          space-between;

        align-items:
          center;
      }


      .brand {
        font-family:
          Georgia,
          "Times New Roman",
          serif;

        font-size:
          18px;

        letter-spacing:
          0.025em;
      }


      nav {
        display:
          flex;

        gap:
          34px;

        font-size:
          11px;

        letter-spacing:
          0.16em;
      }


      /* JOURNAL HERO */

      .journal-hero {
        padding:
          86px 0 76px;
      }


      .journal-kicker {
        margin-bottom:
          30px;

        color:
          var(--muted);

        font-family:
          Arial,
          "Noto Sans KR",
          Helvetica,
          sans-serif;

        font-size:
          11px;

        letter-spacing:
          0.2em;
      }


      .journal-title {
        margin:
          0;

        font-family:
          Georgia,
          "Times New Roman",
          serif;

        font-size:
          clamp(
            52px,
            5.6vw,
            86px
          );

        font-weight:
          400;

        line-height:
          0.98;

        letter-spacing:
          -0.045em;
      }


      /* FEATURED */

      .featured {
        padding:
          48px 0 76px;

        border-top:
          1px solid var(--line);
      }


      .featured-meta {
        display:
          flex;

        gap:
          28px;

        margin-bottom:
          40px;

        color:
          var(--muted);

        font-family:
          Arial,
          "Noto Sans KR",
          Helvetica,
          sans-serif;

        font-size:
          10px;

        letter-spacing:
          0.17em;
      }


      .featured-grid {
        display:
          grid;

        grid-template-columns:
          1.05fr 0.95fr;

        gap:
          76px;

        align-items:
          start;
      }


      .featured-copy {
        padding-top:
          6px;
      }


      .featured-title {
        max-width:
          620px;

        margin:
          0;

        font-family:
          Georgia,
          "Noto Serif KR",
          "Times New Roman",
          serif;

        font-size:
          clamp(
            34px,
            3.6vw,
            48px
          );

        font-weight:
          400;

        line-height:
          1.22;

        letter-spacing:
          -0.03em;

        word-break:
          keep-all;
      }


      .featured-subtitle {
        max-width:
          490px;

        margin:
          28px 0 0;

        color:
          var(--body);

        font-family:
          Arial,
          "Noto Sans KR",
          Helvetica,
          sans-serif;

        font-size:
          15px;

        line-height:
          1.85;

        word-break:
          keep-all;
      }


      .featured-link {
        display:
          inline-block;

        margin-top:
          40px;

        padding-bottom:
          6px;

        border-bottom:
          1px solid var(--text);

        font-family:
          Arial,
          "Noto Sans KR",
          Helvetica,
          sans-serif;

        font-size:
          10px;

        letter-spacing:
          0.16em;
      }


      .featured-visual {
        display:
          block;

        width:
          100%;

        margin-left:
          auto;
      }


      .featured-visual img {
        display:
          block;

        width:
          100%;

        aspect-ratio:
          16 / 9;

        object-fit:
          cover;
      }


      .image-caption {
        display:
          block;

        margin-top:
          10px;

        color:
          var(--muted);

        font-family:
          Arial,
          "Noto Sans KR",
          Helvetica,
          sans-serif;

        font-size:
          10px;

        font-style:
          italic;
      }


      /* ARCHIVE */

      .archive {
        padding:
          42px 0 58px;

        border-top:
          1px solid var(--line);
      }


      .archive-head {
        margin-bottom:
          28px;

        color:
          var(--muted);

        font-family:
          Arial,
          "Noto Sans KR",
          Helvetica,
          sans-serif;

        font-size:
          11px;

        letter-spacing:
          0.2em;
      }


      .archive-list {
        padding-bottom:
          18px;

        border-bottom:
          1px solid var(--line);
      }


      .archive-row {
        display:
          grid;

        grid-template-columns:
          180px 1fr auto;

        gap:
          30px;

        align-items:
          center;

        padding:
          19px 0;

        transition:
          opacity 0.2s ease;
      }


      .archive-row:hover {
        opacity:
          0.55;
      }


      .archive-volume {
        color:
          var(--muted);

        font-family:
          Arial,
          "Noto Sans KR",
          Helvetica,
          sans-serif;

        font-size:
          10px;

        letter-spacing:
          0.15em;
      }


      .archive-title {
        font-family:
          Georgia,
          "Noto Serif KR",
          "Times New Roman",
          serif;

        font-size:
          21px;

        line-height:
          1.35;

        letter-spacing:
          -0.015em;

        word-break:
          keep-all;
      }


      .archive-date {
        color:
          var(--muted);

        font-family:
          Arial,
          "Noto Sans KR",
          Helvetica,
          sans-serif;

        font-size:
          10px;

        letter-spacing:
          0.12em;

        white-space:
          nowrap;
      }


      /* FOOTER */

      footer {
        padding:
          24px 0 38px;

        border-top:
          1px solid var(--line);
      }


      .footer-inner {
        display:
          flex;

        justify-content:
          space-between;

        color:
          var(--muted);

        font-family:
          Arial,
          "Noto Sans KR",
          Helvetica,
          sans-serif;

        font-size:
          10px;

        letter-spacing:
          0.15em;
      }


      /* TABLET */

      @media (max-width: 900px) {

        .page {
          width:
            min(
              100% - 40px,
              1220px
            );
        }


        .journal-hero {
          padding:
            64px 0 52px;
        }


        .journal-title {
          font-size:
            48px;

          line-height:
            1.0;
        }


        .featured-grid {
          grid-template-columns:
            1fr;

          gap:
            40px;
        }


        .featured-title {
          font-size:
            30px;

          line-height:
            1.24;
        }


        .featured-subtitle {
          margin-top:
            20px;

          font-size:
            14.5px;
        }


        .featured-link {
          margin-top:
            30px;
        }


        .featured-visual {
          width:
            100%;

          margin-left:
            0;
        }


        .archive-row {
          grid-template-columns:
            120px 1fr auto;

          gap:
            22px;
        }

      }


      /* MOBILE */

      @media (max-width: 600px) {

        .page {
          width:
            calc(
              100% - 28px
            );
        }


        header {
          padding:
            26px 0 22px;
        }


        .header-inner {
          display:
            block;

          min-height:
            auto;
        }


        nav {
          margin-top:
            20px;

          justify-content:
            space-between;

          gap:
            18px;
        }


        .journal-hero {
          padding:
            48px 0 38px;
        }


        .journal-title {
          font-size:
            38px;

          line-height:
            1.05;
        }


        .featured {
          padding:
            30px 0 48px;
        }


        .featured-meta {
          gap:
            16px;

          margin-bottom:
            24px;
        }


        .featured-title {
          font-size:
            23px;

          line-height:
            1.3;
        }


        .featured-subtitle {
          margin-top:
            14px;

          font-size:
            13.5px;

          line-height:
            1.75;
        }


        .featured-link {
          margin-top:
            24px;
        }


        .archive {
          padding:
            32px 0 42px;
        }


        .archive-row {
          grid-template-columns:
            1fr;

          gap:
            8px;

          padding:
            16px 0;
        }


        .archive-title {
          font-size:
            17px;
        }


        .archive-date {
          margin-top:
            2px;
        }


        .footer-inner {
          flex-direction:
            column;

          gap:
            20px;
        }

      }

    </style>

  </body>
</html>
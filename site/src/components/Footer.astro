---
const socialLinks = [
  {
    label: "LINKEDIN",
    href: "https://www.linkedin.com/in/jaehoon-ju-43837b112/",
  },
  {
    label: "INSTAGRAM",
    href: "https://www.instagram.com/ja3hoooon/",
  },
  {
    label: "THREADS",
    href: "https://www.threads.net/@ja3hoooon",
  },
];
---

<footer>
  <div class="page footer-inner">

    <div class="footer-brand">
      <span>MAISON SAVOIR</span>
      <span>EDITORIAL ARCHIVE</span>
    </div>

    <div class="footer-social">
      {
        socialLinks.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            {social.label}
          </a>
        ))
      }
    </div>

  </div>
</footer>


<style>
  footer {
    padding: 24px 0 38px;

    border-top:
      1px solid rgba(17, 17, 15, 0.18);
  }


  .page {
    width:
      min(
        1220px,
        calc(100% - 72px)
      );

    margin:
      0 auto;
  }


  .footer-inner {
    display:
      flex;

    justify-content:
      space-between;

    align-items:
      center;

    gap:
      40px;
  }


  .footer-brand {
    display:
      flex;

    gap:
      28px;

    color:
      #6f6a63;

    font-size:
      10px;

    letter-spacing:
      0.15em;
  }


  .footer-social {
    display:
      flex;

    gap:
      22px;

    font-size:
      10px;

    letter-spacing:
      0.14em;
  }


  .footer-social a {
    color:
      #6f6a63;

    text-decoration:
      none;

    transition:
      opacity 0.2s ease;
  }


  .footer-social a:hover {
    opacity:
      0.5;
  }


  @media (max-width: 900px) {

    .page {
      width:
        min(
          100% - 40px,
          1220px
        );
    }

  }


  @media (max-width: 600px) {

    .page {
      width:
        calc(100% - 28px);
    }


    .footer-inner {
      flex-direction:
        column;

      align-items:
        flex-start;

      gap:
        20px;
    }


    .footer-brand {
      flex-direction:
        column;

      gap:
        8px;
    }


    .footer-social {
      flex-wrap:
        wrap;

      gap:
        14px 20px;
    }

  }
</style>